# Gemini API Keys (comma-separated list, supporting unlimited keys)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# Model Priority
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash

# Homelab Backend Connection
HOMELAB_API_URL=http://homelab-backend:8080
PROXMOX_HOST=192.168.1.50
DOMAIN=958901.xyz
PORT=8090
